{
  "$meta": { "name": "K-GX E-SFC Policy Lab", "brand": "PLANiT Institute", "base": "1440px desktop, 1024px supported" },
  "color": {
    "navy": { "950": "#0D1A33", "900": "#1A2E55", "800": "#24406F", "700": "#1F3A68", "300": "#9DAECB", "100": "#E7ECF5", "50": "#F4F6FA" },
    "gold": { "700": "#5E4512", "600": "#7A5B17", "500": "#94701F", "400": "#B8892B", "300": "#C9A043", "200": "#E5D3A1", "100": "#F5EBD0", "50": "#FBF5E4" },
    "paper": { "bg": "#F5F1E8", "surface": "#FFFDF8", "surfaceRaised": "#FFFFFF", "sunken": "#F0EBDF", "subtle": "#FAF7F0", "changedRow": "#FCF8EE" },
    "line": { "default": "#E3DCCB", "row": "#EEE8DB", "strong": "#CBC2AD" },
    "text": { "primary": "#1B2230", "secondary": "#4B5363", "muted": "#737985", "heading": "#1A2E55", "onNavy": "#FFFFFF", "onNavyMuted": "#B9C3D6" },
    "delta": { "positive": "#1E5AA8", "negative": "#B2432A", "zero": "#737985", "glyph": { "positive": "▲", "negative": "▼", "zero": "＝" } },
    "status": {
      "ok": { "fg": "#23704F", "bg": "#E2EFE6", "glyph": "✓", "label": "정합" },
      "bad": { "fg": "#A83A22", "bg": "#F7E3DC", "glyph": "✕", "label": "불일치" }
    },
    "sign": { "asset": { "fg": "#1A2E55", "bg": "#E7ECF5", "glyph": "+" }, "liability": { "fg": "#9A3B22", "bg": "#F7E6DE", "glyph": "−" } },
    "grade": {
      "A": { "bg": "#1A2E55", "fg": "#FFFFFF", "border": "1px solid #1A2E55", "meaning": "공식 통계·확정" },
      "B": { "bg": "#E7ECF5", "fg": "#1A2E55", "border": "1px solid #9DAECB", "meaning": "추정·문헌" },
      "C": { "bg": "transparent", "fg": "#7A5B17", "border": "1px dashed #B8892B", "meaning": "근사·가정" }
    },
    "sourceBadge": {
      "official": { "label": "공식", "bg": "#1A2E55", "fg": "#FFFFFF", "border": "1px solid #1A2E55" },
      "press": { "label": "보도", "bg": "#FFFDF8", "fg": "#1A2E55", "border": "1px solid #1A2E55" },
      "unverified": { "label": "? 미확인", "bg": "transparent", "fg": "#7A5B17", "border": "1px dashed #B8892B" }
    },
    "chart": {
      "series": ["#1F3A68", "#B8892B", "#2F8073", "#8C4A6B"],
      "reference": "#8A8F99",
      "current": { "strokeWidth": 2, "dash": "none" },
      "baseline": { "strokeWidth": 1.4, "dash": "4 3", "opacity": 0.8, "note": "기준선은 같은 색 점선" },
      "grid": "#EEE8DB", "axis": "#CBC2AD", "tooltipBg": "#0D1A33",
      "scenario": { "G": "#A35A2A", "R": "#2F8073", "M": "#4C66A3", "N": "#7B5A9A" }
    }
  },
  "font": {
    "family": "'Pretendard Variable', Pretendard, -apple-system, 'Apple SD Gothic Neo', sans-serif",
    "numeric": "font-feature-settings: 'tnum' 1 (전역)",
    "wordBreak": "keep-all",
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "heavy": 800 }
  },
  "fontSize": {
    "display": { "size": "28px", "lineHeight": 1.3, "weight": 700 },
    "h2": { "size": "17px", "lineHeight": 1.4, "weight": 700 },
    "h3": { "size": "16px", "lineHeight": 1.5, "weight": 700 },
    "lead": { "size": "15px", "lineHeight": 1.75 },
    "body": { "size": "13px", "lineHeight": 1.6 },
    "table": { "size": "12.5px", "lineHeight": 1.5 },
    "label": { "size": "12px", "lineHeight": 1.4 },
    "caption": { "size": "11px", "lineHeight": 1.4 },
    "kpi": { "size": "24px", "lineHeight": 1.1, "weight": 700 },
    "eyebrow": { "size": "12px", "weight": 600, "letterSpacing": "0.04em" }
  },
  "space": { "0": "0", "1": "2px", "2": "4px", "3": "6px", "4": "8px", "5": "10px", "6": "12px", "7": "14px", "8": "16px", "9": "20px", "10": "24px", "11": "28px", "12": "32px", "13": "72px" },
  "layout": {
    "maxWidth": "1440px",
    "pagePaddingX": "clamp(20px, 2.5vw, 32px)",
    "navHeight": "56px",
    "controlPanelWidth": "300px",
    "columnGap": "20px",
    "kpiColumns": 4,
    "chartMinWidth": "310px",
    "controlHeight": "32px",
    "segmentHeight": "26px"
  },
  "radius": { "xs": "3px", "sm": "4px", "md": "5px", "lg": "6px", "pill": "999px" },
  "shadow": {
    "none": "none",
    "tooltip": "0 4px 14px rgba(13, 26, 51, 0.22)",
    "popover": "0 8px 24px rgba(13, 26, 51, 0.16)",
    "note": "면은 그림자 대신 1px 선(line.default)으로 구분한다"
  }
}
